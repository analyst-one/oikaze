{
  "name": "oikaze",
  "version": "3.1.0-rc3",
  "description": "",
  "main": "oikaze/index.scss",
  "scripts": {
    "test": "jest",
    "watch": "jest --watchAll",
    "check": "prettier --check .",
    "fix": "prettier --write .",
    "start:sass": "npm run build:sass -- --watch",
    "start:examples": "npm run build:examples -- --watch",
    "start:eleventy": "eleventy --serve --port 28080",
    "build:sass": "sass src/sass:src/css --load-path=node_modules/ --load-path=./ -p node --quiet-deps",
    "build:style-dictionary": "cd examples/style-dictionary/ && style-dictionary build",
    "build:examples": "sass ./examples/:./examples/ --load-path=node_modules/ --load-path=./ --no-source-map -p node --quiet-deps",
    "build:api": "sassdoc ./oikaze/ -d ./docs/api/",
    "build:eleventy": "eleventy",
    "start": "npm-run-all --parallel start:*",
    "build": "npm-run-all fix build:*",
    "clean": "rm -rf docs && rm -rf src/css",
    "version": "chg release -y && git add -A CHANGELOG.md",
    "np": "np  --any-branch --tag next"
  },
  "files": [
    "index.scss",
    "oikaze/*.*"
  ],
  "author": "Analyst1",
  "license": "MIT",
  "peerDependencies": {
    "sass": "^1.89.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@angular/material": "^19.2.16",
    "bootstrap": "^5.3.6",
    "chg": "^0.4.0",
    "jest": "^30.2.0",
    "markdown-it-attrs": "^4.1.6",
    "markdown-it-container": "^3.0.0",
    "normalize.css": "^8.0.1",
    "np": "^10.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "sass": "^1.89.0",
    "sassdoc": "^2.7.4",
    "style-dictionary": "^3.8.0"
  },
  "engines": {
    "node": ">=16.6.0",
    "npm": ">=7.19.0"
  }
}
